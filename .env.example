# SniperPlug — example environment configuration.
#
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# NEVER commit a real `.env` — it is gitignored. This file contains only
# placeholders and public defaults; every secret below is empty or a
# `your-...` placeholder. Production secrets belong in Discloud env vars.
#
# Conventions: `true`/`false` (also accepts 1/0, yes/no, on/off) for flags.
# An unset var always falls back to the default noted in its comment.

# ---------------------------------------------------------------------------
# Discord / bot core
# ---------------------------------------------------------------------------

# REQUIRED. Bot token from the Discord Developer Portal.
DISCORD_TOKEN=your-discord-bot-token

# Local SQLite database file. Default: ./data/sniperplug.sqlite3
DATABASE_PATH=./data/sniperplug.sqlite3

# Optional. Single dev guild ID used to scope slash-command syncs while testing.
DEV_GUILD_ID=

# Optional. Comma-separated dev guild IDs (same purpose as DEV_GUILD_ID).
DEV_GUILD_IDS=

# Optional. Sync commands globally on boot. Default: false
SYNC_GLOBAL_COMMANDS=false

# Optional. Force a slash-command sync on every boot. Default: false, unless
# dev guild IDs are set or SYNC_GLOBAL_COMMANDS is true.
SYNC_COMMANDS_ON_BOOT=false

# Optional. Delete stale global commands on boot. Default: false
# (Leave off unless you are cleaning up after a rename/removal.)
CLEAR_STALE_GLOBAL_COMMANDS_ON_BOOT=false

# Optional. Enable the privileged message-content intent. Default: false
ENABLE_MESSAGE_CONTENT_INTENT=false

# ---------------------------------------------------------------------------
# Walmart Affiliate API (signed) — the live price pipeline
# ---------------------------------------------------------------------------

# Optional. Master switch for the Walmart provider. Default: false
WALMART_PROVIDER_ENABLED=false

# REQUIRED when WALMART_PROVIDER_ENABLED=true. Affiliate API consumer ID.
WALMART_CONSUMER_ID=your-walmart-consumer-id

# Key version for the signed requests. Default: 1
WALMART_KEY_VERSION=1

# REQUIRED when WALMART_PROVIDER_ENABLED=true. Base64 private key for
# signing Affiliate API requests. Keep this out of git and chat.
WALMART_PRIVATE_KEY_B64=your-walmart-private-key-base64

# Optional. Affiliate publisher ID attached to outgoing links.
WALMART_PUBLISHER_ID=your-walmart-publisher-id

# Optional. OAuth access token for the Solution Provider flow. When set (or
# WALMART_SOLUTION_PROVIDER_OAUTH_TOKEN), item-detail responses become
# eligible for strict Cash proof. Default: unset (signed Affiliate API used).
WALMART_OAUTH_ACCESS_TOKEN=

# Optional. Same purpose as WALMART_OAUTH_ACCESS_TOKEN; either token enables
# the OAuth/Solution Provider capability mode. Default: unset.
WALMART_SOLUTION_PROVIDER_OAUTH_TOKEN=

# Optional. Enable the product-page (PDP) recovery probe that fills in
# seller/offer identity when the API omits it. It NEVER supplies a missing
# price. Default: true
WALMART_PAGE_RECOVERY_ENABLED=true

# Optional. Per-page timeout (seconds) for the PDP recovery probe.
# Default: 8 (clamped 3-20).
WALMART_PAGE_RECOVERY_TIMEOUT_SECONDS=8

# ---------------------------------------------------------------------------
# Walmart quotas and worker timeouts
# ---------------------------------------------------------------------------

# Optional. Affiliate API call caps per window; 0 = uncapped (default).
# Enforced by the quota guard; unset windows stay uncapped.
WALMART_MONTHLY_LIMIT=0
WALMART_DAILY_LIMIT=0
WALMART_HOURLY_LIMIT=0

# Optional. Watchdog timeout (seconds) for one exact-worker cycle.
# Default: 600
WALMART_EXACT_WORKER_CYCLE_TIMEOUT_SECONDS=600

# Optional. Watchdog timeout (seconds) for one catalog-discovery cycle.
# Default: 300
WALMART_CATALOG_DISCOVERY_TIMEOUT_SECONDS=300

# Optional. Consecutive failed worker cycles before /autoscan_health flags
# the worker as needing attention. Default: 3
WALMART_WORKER_CYCLE_FAILURE_ALERT_THRESHOLD=3

# ---------------------------------------------------------------------------
# Walmart priority sniper lane
# ---------------------------------------------------------------------------

# Optional. Run the priority sniper lane every N batches. Default: 5
SNIPERPLUG_PRIORITY_SNIPER_EVERY_N_BATCHES=5

# Optional. Max priority sniper runs per hour. Default: 12
SNIPERPLUG_PRIORITY_SNIPER_MAX_PER_HOUR=12

# One in 12 Walmart catalog batches probes bestseller-sorted results using
# an EXISTING broad-search slot. No extra calls; set false to disable canary.
# The returned order is an interest clue, NOT verified sales or price proof.
SNIPERPLUG_BESTSELLER_CANARY_ENABLED=true

# Sample page two on selected ordinary price-sniper batches to find valuable
# offers below >25 cheap accessory listings. Reuses an existing request slot.
# First rotation sniper and priority/hot sniper always use page one.
SNIPERPLUG_PRICE_SNIPER_PAGE2_ENABLED=true

# ---------------------------------------------------------------------------
# Target watcher (RedSky) — standalone app or embedded worker
# ---------------------------------------------------------------------------

# REQUIRED for the Target watcher. RedSky API key (deployment secret).
TARGET_REDSKY_API_KEY=your-target-redsky-api-key

# Optional. RedSky aggregation origin; must stay Target's official origin.
# Default: https://redsky.target.com/redsky_aggregations/v1/web
TARGET_REDSKY_BASE_URL=https://redsky.target.com/redsky_aggregations/v1/web

# Optional. Target PDP sitemap index; must be an official target.com URL.
# Default: https://www.target.com/sitemap_pdp-index.xml.gz
TARGET_SITEMAP_INDEX_URL=https://www.target.com/sitemap_pdp-index.xml.gz

# Optional. Comma-separated TCINs to watch explicitly (5-12 digits each).
TARGET_WATCH_TCINS=

# Optional. Watcher loop interval (seconds). Default: 15 (clamped 10-3600).
TARGET_WATCHER_LOOP_SECONDS=15

# Optional. Sitemap entries processed per batch. Default: 2 (clamped 1-20).
TARGET_SITEMAP_BATCH_SIZE=2

# Optional. Products processed per batch. Default: 20 (clamped 1-24).
TARGET_PRODUCT_BATCH_SIZE=20

# Optional. Store locations scanned per cycle. Default: 2 (clamped 1-25).
TARGET_LOCATIONS_PER_CYCLE=2

# Optional. Products checked per location batch. Default: 20 (clamped 1-24).
TARGET_PRODUCTS_PER_LOCATION_BATCH=20

# Optional. Seconds between location scans. Default: 15 (clamped 10-3600).
TARGET_LOCATION_SCAN_SPACING_SECONDS=15

# Optional. Concurrent Target requests. Default: 3 (clamped 1-8).
TARGET_REQUEST_CONCURRENCY=3

# Optional. Per-request timeout (seconds). Default: 20 (clamped 3-90).
TARGET_REQUEST_TIMEOUT_SECONDS=20

# Optional. Max sitemap download size, compressed bytes. Default: 26214400.
TARGET_SITEMAP_MAX_COMPRESSED_BYTES=26214400

# Optional. Max sitemap size after decompression, bytes. Default: 104857600.
TARGET_SITEMAP_MAX_EXPANDED_BYTES=104857600

# Optional. Minimum discount % for an event offer. Default: 10 (clamped 1-95).
TARGET_MIN_EVENT_DISCOUNT_PERCENT=10

# Optional. Minutes between repeat offers for the same normal deal.
# Default: 30 (clamped 5-1440).
TARGET_NORMAL_OFFER_INTERVAL_MINUTES=30

# Optional. Seconds between repeat offers for the same markdown deal.
# Default: 90 (clamped 30-3600).
TARGET_MARKDOWN_OFFER_INTERVAL_SECONDS=90

# Optional. Minutes between sitemap refreshes. Default: 30 (clamped 5-1440).
TARGET_SITEMAP_REFRESH_MINUTES=30

# Optional. Reference-price floor ($) for big-ticket handling.
# Default: 200 (clamped 100-10000).
TARGET_BIG_TICKET_MIN_REFERENCE_PRICE=200

# Optional. Minimum discount % for a price-error call. Default: 69 (50-95).
TARGET_PRICE_ERROR_MIN_DISCOUNT_PERCENT=69

# Optional. Seconds between repeat big-ticket offers. Default: 45 (30-600).
TARGET_BIG_TICKET_OFFER_INTERVAL_SECONDS=45

# Optional. Standalone watcher must share the Turso/libSQL database in
# production. Set false only for local tests. Default: true
TARGET_WATCHER_REQUIRE_REMOTE_DB=true

# Optional. Run one cycle then exit (local testing). Default: false
TARGET_WATCHER_RUN_ONCE=false

# Optional. User-Agent sent to Target.
# Default: SniperPlug-Target-Watcher/1.0 (+https://sniperplug.com)
TARGET_WATCHER_USER_AGENT=SniperPlug-Target-Watcher/1.0 (+https://sniperplug.com)

# ---------------------------------------------------------------------------
# HP watcher — standalone app or embedded worker (deliberately OFF in prod
# until its transport/PDP timeout work lands; see docs/DISCLOUD_DEPLOY.md)
# ---------------------------------------------------------------------------

# Optional. HP sitemap index; must be an official hp.com URL.
# Default: https://www.hp.com/sitemap-index-store-us-en.xml
HP_SITEMAP_INDEX_URL=https://www.hp.com/sitemap-index-store-us-en.xml

# Optional. HP price endpoint; must be an official hp.com URL.
# Default: https://www.hp.com/webapp/wcs/stores/servlet/HPServices
HP_PRICE_ENDPOINT_URL=https://www.hp.com/webapp/wcs/stores/servlet/HPServices

# Optional. Watcher loop interval (seconds). Default: 10 (clamped 10-3600).
HP_WATCHER_LOOP_SECONDS=10

# Optional. Sitemap entries processed per batch. Default: 2 (clamped 1-20).
HP_SITEMAP_BATCH_SIZE=2

# Optional. Product pages processed per batch. Default: 24 (clamped 1-100).
HP_PRODUCT_PAGE_BATCH_SIZE=24

# Optional. Offers processed per batch. Default: 80 (clamped 1-100).
HP_OFFER_BATCH_SIZE=80

# Optional. Concurrent HP requests. Default: 3 (clamped 1-8).
HP_REQUEST_CONCURRENCY=3

# Optional. Per-request timeout (seconds). Default: 20 (clamped 3-90).
HP_REQUEST_TIMEOUT_SECONDS=20

# Optional. Minimum discount % for an event offer. Default: 10 (clamped 1-95).
HP_MIN_EVENT_DISCOUNT_PERCENT=10

# Optional. Minutes between repeat offers for the same normal deal.
# Default: 30 (clamped 5-1440).
HP_NORMAL_OFFER_INTERVAL_MINUTES=30

# Optional. Seconds between repeat offers for the same markdown deal.
# Default: 90 (clamped 30-3600).
HP_MARKDOWN_OFFER_INTERVAL_SECONDS=90

# Optional. Hours between product-page refreshes. Default: 24 (clamped 1-720).
HP_PRODUCT_PAGE_REFRESH_HOURS=24

# Optional. Minutes between sitemap refreshes. Default: 10 (clamped 2-1440).
HP_SITEMAP_REFRESH_MINUTES=10

# Optional. Reference-price floor ($) for big-ticket handling.
# Default: 200 (clamped 100-10000).
HP_BIG_TICKET_MIN_REFERENCE_PRICE=200

# Optional. Minimum discount % for a price-error call. Default: 69 (50-95).
HP_PRICE_ERROR_MIN_DISCOUNT_PERCENT=69

# Optional. Seconds between repeat big-ticket offers. Default: 45 (30-600).
HP_BIG_TICKET_OFFER_INTERVAL_SECONDS=45

# Optional. Standalone watcher must share the Turso/libSQL database in
# production. Set false only for local tests. Default: true
HP_WATCHER_REQUIRE_REMOTE_DB=true

# Optional. Run one cycle then exit (local testing). Default: false
HP_WATCHER_RUN_ONCE=false

# Optional. User-Agent sent to HP.
# Default: SniperPlug-HP-Watcher/1.1 (+https://sniperplug.com)
HP_WATCHER_USER_AGENT=SniperPlug-HP-Watcher/1.1 (+https://sniperplug.com)

# ---------------------------------------------------------------------------
# Home Depot via SerpApi
# ---------------------------------------------------------------------------

# Optional. SerpApi key enabling Home Depot lookups. Unset = disabled.
SERPAPI_API_KEY=your-serpapi-api-key

# Optional. SerpApi monthly call caps for the quota guard.
# Defaults: monthly 250, safe monthly 200, daily 30, hourly per-user 12.
SERPAPI_MONTHLY_LIMIT=250
SERPAPI_SAFE_MONTHLY_LIMIT=200
SERPAPI_DAILY_LIMIT=30
SERPAPI_HOURLY_USER_LIMIT=12

# ---------------------------------------------------------------------------
# Best Buy — STAGED STUB ONLY
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Verizon Shine relay (optional local relay endpoint)
# ---------------------------------------------------------------------------

# Optional. Start the Verizon Shine relay endpoint. Default: off.
VERIZON_SHINE_RELAY_ENABLED=false

# Optional. Relay bind host. Default: 127.0.0.1
VERIZON_SHINE_RELAY_HOST=127.0.0.1

# Optional. Relay bind port. Default: 8082
VERIZON_SHINE_RELAY_PORT=8082

# REQUIRED when VERIZON_SHINE_RELAY_ENABLED=true. Shared secret for the
# relay endpoint (must be at least 16 characters).
VERIZON_SHINE_RELAY_SECRET=your-verizon-shine-relay-secret

# ---------------------------------------------------------------------------
# Storage — Turso / libSQL remote database (legacy; local SQLite is the
# canonical production backend — see SNIPERPLUG_LOCAL_SQLITE below)
# ---------------------------------------------------------------------------

# REQUIRED when using the remote database. Turso database URL.
TURSO_DATABASE_URL=your-turso-database-url

# REQUIRED when using the remote database. Turso auth token.
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional. libSQL aliases for the same URL/token; TURSO_* take precedence
# when both are set. Default: unset.
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# Optional. Allow the experimental embedded-replica path (native libSQL
# driver). Falls back to the direct remote process on any startup failure.
# Default: false
TURSO_EMBEDDED_REPLICA_ENABLED=false

# Optional. Override the embedded-replica file path. Default: derived from
# DATABASE_PATH.
TURSO_REPLICA_PATH=

# Optional. Timeout (seconds) for a single Turso operation. Default: 90
TURSO_OPERATION_TIMEOUT_SECONDS=90

# Optional. Timeout (seconds) for the Turso child-process startup.
# Default: 45
TURSO_PROCESS_STARTUP_TIMEOUT_SECONDS=45

# Optional. Timeout (seconds) for the startup readiness window.
# Default: 300
TURSO_STARTUP_READINESS_TIMEOUT_SECONDS=300

# Optional. Timeout (seconds) for embedded-replica startup. Default: 180
TURSO_REPLICA_STARTUP_TIMEOUT_SECONDS=180

# Optional. Seconds between embedded-replica syncs. Default: 10
TURSO_REPLICA_SYNC_INTERVAL_SECONDS=10

# ---------------------------------------------------------------------------
# Local SQLite production mode (canonical backend)
# ---------------------------------------------------------------------------

# Optional. Assert explicit local-SQLite production mode. Requires an
# existing non-empty database file and NO Turso/libSQL credentials set.
# Default: false
SNIPERPLUG_LOCAL_SQLITE=false

# Optional. One-time override allowing a fresh/empty database on first boot.
# Remove immediately after the first successful boot. Default: false
SNIPERPLUG_LOCAL_SQLITE_ALLOW_EMPTY=false

# Optional. Run the HP watcher embedded in this same app (requires
# SNIPERPLUG_LOCAL_SQLITE=true). Default: false
SNIPERPLUG_EMBED_HP_WATCHER=false

# Optional. Run the Target watcher embedded in this same app (requires
# SNIPERPLUG_LOCAL_SQLITE=true). Default: true in the documented Discloud
# deploy; false here — set explicitly when embedding.
SNIPERPLUG_EMBED_TARGET_WATCHER=false

# Optional. Hours between local SQLite backups. Default: 6
SNIPERPLUG_SQLITE_BACKUP_INTERVAL_HOURS=6

# Optional. Number of local SQLite backups to retain. Default: 14
SNIPERPLUG_SQLITE_BACKUP_RETENTION=14

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Optional. Log level: DEBUG, INFO, WARNING, ERROR. Default: INFO
SNIPERPLUG_LOG_LEVEL=INFO

# Optional. Log file path. Default: ./data/logs/sniperplug.log
SNIPERPLUG_LOG_FILE=./data/logs/sniperplug.log

# Optional. Max log file size in bytes before rotation. Default: 5242880
SNIPERPLUG_LOG_MAX_BYTES=5242880

# Optional. Number of rotated log files to keep. Default: 5
SNIPERPLUG_LOG_BACKUPS=5

# ---------------------------------------------------------------------------
# eBay official Browse research and EPN messaging consent (single bot, SQLite)
# ---------------------------------------------------------------------------
# Production Client ID and Client Secret come from developer.ebay.com keys.
# NEVER use EPN portal API tokens or commit credentials to source.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Research stays disabled until production credentials are configured.
EBAY_RESEARCH_ENABLED=false
# Only use true when intentionally testing sandbox (not real market listings).
EBAY_SANDBOX=false
# Optional 10-digit eBay Partner Network campaign ID for approved linking.
EBAY_EPN_CAMPAIGN_ID=
# Must remain false until eBay provides actual written Messaging approval.
# No automatic promotional sender is part of this integration.
EBAY_EPN_MESSAGING_APPROVED=false
