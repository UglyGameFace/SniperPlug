NAME=SniperPlug
TYPE=bot
MAIN=main.py
RAM=512
# Keep the Rust-backed libSQL/Turso driver on a stable supported interpreter.
# Never use VERSION=latest here; silent runtime upgrades previously moved
# production to Python 3.14 and triggered native worker-thread panics.
VERSION=3.11
AUTORESTART=true
BUILD=pip install -r requirements.txt
