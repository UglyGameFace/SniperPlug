NAME=SniperPlug
TYPE=bot
MAIN=main.py
RAM=512
# Keep production on the documented stable Python runtime. Do not use `latest`:
# Discloud moved it to Python 3.14, where the experimental Rust-backed libsql
# driver emitted native Option::unwrap() panics outside Python exception handling.
VERSION=3.11
AUTORESTART=true
BUILD=pip install -r requirements.txt
