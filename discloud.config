NAME=SniperPlug
TYPE=bot
MAIN=main.py
# Diamond provides enough headroom to keep the Discord bot plus the optional
# HP/Target watcher tasks in this one app. Their SQLite connections share the
# same local WAL database without a paid remote database service.
RAM=1024
# Keep production on the validated interpreter instead of following latest.
# A prior silent move to Python 3.14 triggered unsupported native libSQL worker failures.
VERSION=3.11
AUTORESTART=true
BUILD=pip install -r requirements.txt
