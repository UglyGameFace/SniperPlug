# STANDALONE REMOTE-DB DEPLOYMENT.
# This app runs the HP watcher as its own Discloud application, sharing the
# production Turso/libSQL database with the canonical SniperPlug app (the
# watcher requires TURSO_DATABASE_URL and TURSO_AUTH_TOKEN and fails closed
# without them). It publishes only exact-confirmed events into the shared
# retailer_verified_deal_events table; the canonical app remains the only
# Discord publisher. Do not run this app at the same time as an embedded HP
# watcher (SNIPERPLUG_EMBED_HP_WATCHER=true) on the canonical app: exactly
# one HP watcher may own the catalog at a time.
NAME=SniperPlug-HP-Watcher
TYPE=bot
MAIN=hp_watcher_main.py
RAM=256
VERSION=3.11
AUTORESTART=true
BUILD=pip install -r requirements.txt
