# LEGACY STANDALONE REMOTE-DB DEPLOYMENT ONLY.
# Do not deploy this app when the canonical SniperPlug app uses
# SNIPERPLUG_LOCAL_SQLITE=true. Local production embeds the Target watcher in the
# canonical app so every retailer uses one authoritative SQLite file.
NAME=SniperPlug-Target-Watcher
TYPE=bot
MAIN=target_watcher_main.py
RAM=256
VERSION=3.11
AUTORESTART=true
BUILD=pip install -r requirements.txt
